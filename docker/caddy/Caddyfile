

#既存のCOACHTECHプロジェクトの設定 (例)



#↓↓↓ ここから、今回追加する laravel.test の設定 (Nginxリバースプロキシ) ↓↓↓



#laravel.test {
# Nginxサービス（Laravelバックエンド）へリバースプロキシ
# ホスト名 'nginx' は docker-compose.yml で定義されたサービス名です。
#reverse_proxy nginx:80

# Caddyは自動的にホスト名 'laravel.test' に対して
# 開発用のSSL証明書を作成し、HTTPSでアクセス可能になります。

# 開発時に便利なログの有効化 (オプション)
#log {
#    output stdout
#    format json
#}



#今回追加する laravel.test の設定 (Nginxリバースプロキシ)



#1. グローバル設定ブロック（ファイルの先頭に独立して置く）

{
    auto_https disable_redirects
    email your@email.com
}

# Laravel (Backend)
https://laravel.test:4430 {
    tls /etc/caddy/laravel.test.pem /etc/caddy/laravel.test-key.pem
    reverse_proxy http://nginx:80 {

        transport http {
            read_timeout 10m
            write_timeout 10m
            dial_timeout 5s
        }

        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto https
    }
}

# Nuxt (Frontend)
https://laravel.test:4431 {
    tls /etc/caddy/laravel.test.pem /etc/caddy/laravel.test-key.pem
    reverse_proxy http://frontend_dev:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto https
    }
}
