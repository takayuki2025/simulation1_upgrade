<?php

namespace App\Modules\Item\Infrastructure\Persistence\Repository;

use App\Models\ItemEntityTag;
use Illuminate\Support\Facades\DB;
use App\Modules\Item\Domain\Entity\Brand;

final class EloquentItemEntityTagRepository
{
    /**
     * @param Brand[] $entities
     */
    public function replaceByItemId(
        int $itemId,
        string $tagType,
        array $entities
    ): void {
        DB::transaction(function () use ($itemId, $tagType, $entities) {
            ItemEntityTag::where('item_id', $itemId)
                ->where('tag_type', $tagType)
                ->delete();

            foreach ($entities as $entity) {
                ItemEntityTag::create([
                    'item_id' => $itemId,
                    'tag_type' => $tagType,
                    'entity_id' => $entity->id,
                    'display_name' => $entity->displayName,
                    'confidence' => $entity->confidence,
                ]);
            }
        });
    }
}
